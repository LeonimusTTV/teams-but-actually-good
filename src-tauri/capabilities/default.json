{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://teams.cloud.microsoft/*",
      "https://teams.microsoft.com/*",
      "https://teams.live.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "allow-open-chat-popup"
  ]
}